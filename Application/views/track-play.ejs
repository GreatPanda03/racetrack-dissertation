<!DOCTYPE html>

<html lang="en">
<head>
    <%- include("./partials/head.ejs") %>
    <script type="module" src="/js/track-play.js" defer></script>
</head>
<body>
    <div class="container">
        <nav>
            <%- include("./partials/nav.ejs") %>
        </nav>

        <div class="content">
            <div class="introduction">
                <p>
                    Welcome to <b><%= track.name %></b>! Start your engines...
                </p>
                <p>
                    Your race car moves using <b>vectors</b>. This vector affects your current velocity, determining where you can move.
                    Each turn, you can only change your velocity by at most 1 unit horizontally, 1 unit vertically, or both.
                    Watch out for materials: if you're in them, they can affect your next move!
                </p>
            </div>
            
            <hr/>
            
            <div>
                <!-- TODO: display track details -->
            </div>

            <div>
                <div class="d-flex gap-3" style="margin-bottom: 10px;">
                    <div>
                        <i data-lucide="clock"></i>
                        <span id="race-time">
                            <b>Time:</b> 999 seconds
                        </span>
                    </div>
                </div>

                <div class="d-flex gap-3">
                    <div class="canvas-wrapper">
                        <canvas id="track-canvas" width="750" height="750" style="z-index: 0;"></canvas>
                        <canvas id="play-canvas" width="750" height="750" style="z-index: 1;"></canvas>
                    </div>

                    <div id="race-stats">
                        <div id="stats-header">
                            Your Stats
                        </div>
                        <hr>
                        <div id="stats-body" class="d-flex flex-column"></div>
                        <!-- script generated -->
                    </div>
                </div>
            </div>
        </div>

        <div id="modal-race-results" class="modal fade" tabindes="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">You Win!</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body results">
                        <p></p> <!-- script generated -->
                    </div>
                    <div class="modal-footer d-flex justify-content-center">
                        <button id="results-build" class="btn btn-primary" data-bs-dismiss="modal" hidden>
                            <i data-lucide="hammer"></i>
                            Continue Building
                        </button>
                        <button id="results-retry" class="btn btn-danger" data-bs-dismiss="modal">
                            <i data-lucide="wrench"></i>
                            Retry from Last Point
                        </button>
                    </div>
                </div>
            </div>
        </div>  
            
        <footer>
            <%- include("./partials/footer.ejs") %>
        </footer>
    </div>

    <script>
        window.track = <%- JSON.stringify(track) %>;
        window.racecarId = <%- JSON.stringify(racecarId) %>;
    </script>
</body>
</html>