<!DOCTYPE html>

<html lang="en">
<head>
    <%- include("./partials/head.ejs") %>
    <script type="module" src="/track-builder.js" defer></script>
</head>
<body>
    <div class="container">
        <nav>
            <%- include("./partials/nav.ejs") %>
        </nav>

        <div class="content">
            <div>
                <p>
                    Welcome to the <b>Track Builder</b>. You can use this section to build your own tracks.
                </p>
                <p>
                    Tracks are defined as a series of points, starting from Point 1.
                    When more than 3 points are placed, a path if formed between all points.
                    The builder also comes with a grid, showing where race cars can drive to.
                    Race cars can only drive to a point on top of the track path, otherwise they crash!
                </p>
                <p>
                    There are a few track elements to build with:
                    <ul>
                        <li><b>Path:</b> defines the form of the track</li>
                        <li><b>Materials:</b> a track element which affects racer movement</li>
                        <li><b>Obstacle:</b> a track element which causes racers to crash when driven into</li>
                        <li><b>Decoration:</b> a track element which is ornamental and has no effect</li>
                    </ul>
                </p>
            </div>
            
            <hr/>
            
            <div id="build-bar">
                <div id="build-options">
                    <div class="mb-2">
                        <i data-lucide="square-mouse-pointer"></i>
                        <b>Options</b>
                    </div>
                    <div>
                        <button id="options-details" class="btn btn-primary">
                            <i data-lucide="notebook-pen"></i>
                            <br/>Details
                        </button>
                        
                        <button id="options-save" class="btn btn-primary">
                            <i data-lucide="save"></i>
                            <br/>Save
                        </button>
                        
                        <button id="options-save-as" class="btn btn-primary">
                            <i data-lucide="save-all"></i>
                            <br/>Save As
                        </button>

                        <button id="options-undo" class="btn btn-primary">
                            <i data-lucide="undo"></i>
                            <br/>Undo
                        </button>

                        <button id="options-redo" class="btn btn-primary">
                            <i data-lucide="redo"></i>
                            <br/>Redo
                        </button>

                        <button id="options-test" class="btn btn-primary">
                            <i data-lucide="play"></i>
                            <br/>Test
                        </button>

                        <button id="options-import" class="btn btn-primary">
                            <i data-lucide="download"></i>
                            <br/>Import
                        </button>

                        <button id="options-export" class="btn btn-primary">
                            <i data-lucide="share"></i>
                            <br/>Export
                        </button>
                    </div>
                </div>

                <div id="build-tools" class="mt-3">
                    <div class="mb-2">
                        <i data-lucide="brush"></i>
                        <b>Tools</b>
                    </div>
                    <div>
                        <button id="tools-path" class="btn btn-primary">
                            <i data-lucide="route"></i>
                            <br/>Path
                        </button>

                        <button id="tools-material" class="btn btn-primary">
                            <i data-lucide="box"></i>
                            <br/>Material
                        </button>

                        <button id="tools-obstacle" class="btn btn-primary">
                            <i data-lucide="brick-wall"></i>
                            <br/>Obstacle
                        </button>

                        <button id="tools-decoration" class="btn btn-primary">
                            <i data-lucide="sprout"></i>
                            <br/>Decor
                        </button>
                    </div>
                </div>
            </div>

            <div>
                <div class="d-flex align-items-end gap-3 mb-2">
                    <h5>
                        <i data-lucide="hammer"></i>
                        <b>Builder</b>
                    </h5>
                    
                    <div>
                        <button id="visuals-nodes" class="btn btn-primary" title="Toggle Nodes">
                            <i class="button-on" data-lucide="circle"></i>
                            <i class="button-off hidden" data-lucide="circle-off"></i>
                        </button>

                        <button id="visuals-edges" class="btn btn-primary" title="Toggle Edges">
                            <i class="button-on" data-lucide="pen"></i>
                            <i class="button-off hidden" data-lucide="pen-off"></i>
                        </button>
                        
                        <button id="visuals-track" class="btn btn-primary" title="Toggle Path">
                            <i class="button-on" data-lucide="route"></i>
                            <i class="button-off hidden" data-lucide="route-off"></i>
                        </button>

                        <button id="nodes-anticlockwise" class="btn btn-primary" title="Shift Nodes Anticlockwise">
                            <i data-lucide="rotate-ccw-square"></i>
                        </button>

                        <button id="nodes-clockwise" class="btn btn-primary" title="Shift Nodes Clockwise">
                            <i data-lucide="rotate-cw-square"></i>
                        </button>
                    </div>
                </div>

                <div class="canvas-wrapper">
                    <canvas id="build-canvas" width="750" height="750"></canvas>
                </div>

                <div class="d-flex">
                    <div id="details-node" class="hidden">
                        <div id="details-node-title">
                            <b>Node X</b>
                        </div>
                        <div id="details-node-width">    
                            <label>Width:</label>
                            <input id="node-width-input" type="number" min=5 max=250 value=25>
                        </div>
                        <div id="details-node-checkpoint">
                            <label>Checkpoint:</label>
                            <input id="node-checkpoint-input" type="checkbox">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <footer>
            <%- include("./partials/footer.ejs") %>
        </footer>
    </div>
</body>
</html>