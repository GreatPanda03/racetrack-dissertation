<!DOCTYPE html>

<html lang="en">
<head>
    <%- include("./partials/head.ejs") %>
    <script type="module" src="/js/tracks-list.js"></script>
</head>
<body>
    <div class="container">
        <nav>
            <%- include("./partials/nav.ejs") %>
        </nav>

        <div class="content">
            <div class="introduction">
                Welcome to the <b>Track List</b> section. Here you can view all game tracks as well as player-made tracks and tracks made by you!

                <div id="track-list" class="mt-5">
                    <div id="nav-tab" class="nav nav-tabs d-flex justify-content-between">
                        <div class="d-flex flex-row">
                            <button id="game-tracks-tab" class="nav-link active" data-bs-toggle="tab" data-bs-target="#game-tracks-pane">Game Tracks</button>
                            <button id="player-tracks-tab" class="nav-link" data-bs-toggle="tab" data-bs-target="#player-tracks-pane">Player Tracks</button>
                            <button id="personal-tracks-tab" class="nav-link" data-bs-toggle="tab" data-bs-target="#personal-tracks-pane">Your Tracks</button>
                        </div>
                        <div class="mb-2">
                            <small id="track-search-count" class="form-text text-muted">Total Results: 0 / 0</small>
                            <div class="d-flex flex-row gap-1">
                                <input id="track-search-input" class="form-control" placeholder="Search Track" aria-label="Search">
                                <button id="track-search-submit" class="btn btn-primary">
                                    <i data-lucide="search"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div id="track-lists" class="tab-content">
                        <div id="game-tracks-pane" class="tab-pane fade show active">
                            <div id="game-tracks-list" class="d-flex flex-wrap gap-3"></div>
                        </div>
                        <div id="player-tracks-pane" class="tab-pane fade">
                            <div id="player-tracks-list" class="d-flex flex-wrap gap-3"></div>
                        </div>
                        <div id="personal-tracks-pane" class="tab-pane fade">
                            <div id="personal-tracks-list" class="d-flex flex-wrap gap-3"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <footer>
            <%- include("./partials/footer.ejs") %>
        </footer>
    </div>

    <!-- track entry details -->
    <div id="modal-track-details" class="modal fade" tabindes="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Track Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">

                    <!-- canvas, track details, & leaderboard -->
                    <div class="d-flex flex-row gap-3">
                        <div class="canvas-wrapped">
                            <canvas id="details-canvas" width="450" height="450"></canvas>
                        </div>
                        <div class="container">
                            <div id="details-info">
                                <!-- script generated -->
                            </div>
                            <hr>
                        </div>
                    </div>

                    <!-- racer options -->
                    <div id="options-racers">
                        <div id="player-racers" class="d-flex flex-column gap-3">
                            <div>
                                <div id="player-racers-header" class="mb-1">
                                    <b id="player-racers-label">Player Racers</b>
                                    <button id="player-racers-add" class="btn btn-primary p-1"
                                        data-bs-toggle="tooltip" data-bs-placement="bottom" title="Add Player Racer"
                                    >
                                        <i data-lucide="circle-plus"></i>
                                    </button>
                                </div>
                                <div id="player-racers-body">
                                    <span class="empty-list" hidden>No player racers</span>
                                    <div id="player-racers-list" class="d-flex gap-2 overflow-auto">
                                        <!-- script generated -->
                                    </div>
                                </div>
                            </div>

                            <div>
                                <div id="robot-racers-header" class="mb-1">
                                    <b id="robot-racers-label">Robot Racers</b>
                                    <button id="robot-racers-add" class="btn btn-primary p-1"
                                        data-bs-toggle="tooltip" data-bs-placement="bottom" title="Add Player Racer"
                                    >
                                        <i data-lucide="circle-plus"></i>
                                    </button>
                                </div>
                                <div id="robot-racers-body">
                                    <span class="empty-list" hidden>No robot racers</span>
                                    <div id="robot-racers-list" class="d-flex gap-2 overflow-auto">
                                        <!-- script generated -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <div class="d-flex justify-content-around gap-3">
                        <button id="details-play" class="btn btn-success">
                            <i data-lucide="play"></i>
                            Play
                        </button>
                        <button id="details-edit" class="btn btn-primary">
                            <i data-lucide="hammer"></i>
                            Edit
                        </button>
                        <button id="details-delete" class="btn btn-danger">
                            <i data-lucide="trash-2"></i>
                            Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>  
    
    <!-- track entry template -->
    <template id="track-list-entry-template">
        <div class="track-entry">
            <div class="entry-body">
                <div class="canvas-wrapped">
                    <canvas class="entry-canvas" width="250" height="250"></canvas>
                </div>
            </div>
            <div class="entry-footer">
                <div class="entry-title">
                    <b>This is the title</b>
                </div>
            </div>
        </div>
    </template>

    <!-- racer entry template -->
    <template id="racer-entry-template">
        <div class="racer-entry container border border-secondary rounded">
            <div class="racer-header d-flex gap-1">
                <i data-lucide="circle" class="racer-colour p-1"></i>
                <div class="racer-details">
                    Racer 1
                </div>
            </div>
            <div class="racer-options" style="width: 200px;">
                <button class="btn-racer-colour btn btn-secondary p-1" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Set Colour">
                    <div class="d-flex align-items-center">
                        <input type="color">     
                        <i data-lucide="brush"></i>
                    </div>
                </button>
                <div class="div-racer-cartype btn-group dropend p-1" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Set Car Type">
                    <button class="btn-racer-cartype btn btn-primary dropdown-toggle" data-bs-toggle="dropdown">
                        <i data-lucide="wrench"></i>
                    </button>
                    <ul class="dropdown-menu">
                        <!-- script generated -->
                    </ul>
                </div>
                <button class="btn-racer-remove btn btn-danger p-1" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Remove Player">
                    <i data-lucide="x"></i>
                </button>
            </div>
        </div>
    </template>

    <!-- race car type info -->
    <template id="car-type-item-template">
        <li class="dropdown-item">
            <div class="d-flex justify-content-between gap-3">
                <span class="car-type-name"></span>
                <i class="car-type-info" data-lucide="info" data-bs-toggle="tooltip" data-bs-placement="right"
                    data-bs-html="true" title="test">
                </i>
            </div>
        </li>
    </template>

    <script>
        window.tracks = <%- JSON.stringify(tracks) %>;
    </script>
</body>
</html>