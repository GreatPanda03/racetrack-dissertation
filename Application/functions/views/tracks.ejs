<!DOCTYPE html>

<html lang="en">
<head>
    <%- include("./partials/head.ejs") %>
    <script type="module" src="/js/page-tracks.js"></script>
</head>
<body>
    <div class="container">
        <nav>
            <%- include("./partials/nav.ejs") %>
        </nav>

        <div class="content">
            <div class="introduction">
                Welcome to the <b>Track List</b> section. Here you can view all game tracks as well as player-made tracks and tracks made by you!

                <div id="track-list" class="mt-5">
                    <div id="nav-tab" class="nav nav-tabs d-flex justify-content-between">
                        <div class="d-flex flex-row">
                            <button id="game-tracks-tab" class="nav-link active" data-bs-toggle="tab" data-bs-target="#game-tracks-pane">Game Tracks</button>
                            <button id="player-tracks-tab" class="nav-link" data-bs-toggle="tab" data-bs-target="#player-tracks-pane">Player Tracks</button>
                            <button id="personal-tracks-tab" class="nav-link" data-bs-toggle="tab" data-bs-target="#personal-tracks-pane">Your Tracks</button>
                        </div>
                        <div class="mb-2">
                            <small id="track-search-count" class="form-text text-muted">Total Results: 0 / 0</small>
                            <div class="d-flex flex-row gap-1">
                                <input id="track-search-input" class="form-control" placeholder="Search Track" aria-label="Search">
                                <button id="track-search-submit" class="btn btn-primary">
                                    <i data-lucide="search"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div id="track-lists" class="tab-content">
                        <div id="game-tracks-pane" class="tab-pane fade show active">
                            <div id="game-tracks-list" class="d-flex flex-wrap gap-3"></div>
                        </div>
                        <div id="player-tracks-pane" class="tab-pane fade">
                            <div id="player-tracks-list" class="d-flex flex-wrap gap-3"></div>
                        </div>
                        <div id="personal-tracks-pane" class="tab-pane fade">
                            <div id="personal-tracks-list" class="d-flex flex-wrap gap-3"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <footer>
            <%- include("./partials/footer.ejs") %>
        </footer>
    </div>

    <!-- track entry details -->
    <div id="modal-track-details" class="modal fade" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Track Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">

                    <!-- canvas, track details, & leaderboard -->
                    <div class="d-flex flex-row gap-3">
                        <div class="canvas-wrapped">
                            <canvas id="details-canvas" width="300" height="300"></canvas>
                            <div id="details-info">
                                <!-- script generated -->
                            </div>
                        </div>
                        <div class="container">
                            <div id="details-leaderboard">
                                <!-- script generated -->
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <div class="d-flex justify-content-around gap-3">
                        <button id="details-play-offline" class="btn btn-warning">
                            <i data-lucide="gamepad-2"></i>
                            Play Locally
                        </button>
                        <button id="details-play-online" class="btn btn-success">
                            <i data-lucide="globe"></i>
                            Play Online
                        </button>
                        <button id="details-edit" class="btn btn-primary">
                            <i data-lucide="hammer"></i>
                            Edit
                        </button>
                        <button id="details-delete" class="btn btn-danger">
                            <i data-lucide="trash-2"></i>
                            Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>  

    <%- include("./partials/toast.ejs") %>
    
    <!-- track entry template -->
    <template id="track-list-entry-template">
        <div class="track-entry">
            <div class="entry-body">
                <div class="canvas-wrapped">
                    <canvas class="entry-canvas" width="250" height="250"></canvas>
                </div>
            </div>
            <div class="entry-footer">
                <div class="entry-title">
                    <b>This is the title</b>
                </div>
            </div>
        </div>
    </template>

    <script>
        window.tracks_ = <%- JSON.stringify(tracks) %>;
        window.leaderboards_ = <%- JSON.stringify(leaderboards) %>;
    </script>
</body>
</html>